<component>
	<api>
		<prop name="label" type="string" default="" help="Row label text" />
		<prop name="value" type="string" default="" help="Row value text" />
		<prop name="show_separator" type="bool" default="true" help="Whether to show bottom divider separator" />
	</api>

	<styles>
		<style
			name="style_info_row"
			width="100%"
			height="content"
			flex_flow="row"
			flex_cross_place="center"
			flex_main_place="space_between"
			bg_opa="0%"
			border_width="1"
			border_side="bottom"
			border_color="#color_card_border"
			border_opa="30%"
			pad_ver="#space_xs"
			pad_hor="0"
		/>
		<style name="style_info_row_label" text_color="#color_text_muted" text_font="font_sm" />
		<style name="style_info_row_value" text_color="#color_text_primary" text_font="font_sm" text_align="right" />
	</styles>

	<view
		extends="lv_obj"
		width="100%"
		height="content"
		flex_flow="row"
		scrollable="false"
		style_flex_main_place="space_between"
		style_flex_cross_place="center"
		style_pad_ver="#space_xs"
		style_pad_hor="0"
		style_bg_opa="0%"
		style_border_width="1"
		style_border_side="bottom"
		style_border_color="#color_card_border"
		style_border_opa="30%"
	>
		<style name="style_info_row" />

		<lv_label text="$label">
			<style name="style_info_row_label" />
		</lv_label>

		<lv_label text="$value">
			<style name="style_info_row_value" />
		</lv_label>
	</view>
</component>
