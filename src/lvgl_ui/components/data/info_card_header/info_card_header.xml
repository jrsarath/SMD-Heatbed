<component>
	<api>
		<prop name="title" type="string" default="SECTION" help="Section header title" />
		<prop name="icon" type="string" default="" help="Section icon or symbol" />
	</api>

	<styles>
		<style
			name="style_card_header"
			width="100%"
			height="content"
			flex_flow="row"
			flex_cross_place="center"
			bg_opa="0%"
			border_width="0"
			pad_all="0"
			pad_gap="#space_xs"
		/>
		<style
			name="style_header_icon"
			text_color="#color_warning"
		/>
		<style
			name="style_header_title"
			text_color="#color_warning"
			text_font="font_sm"
		/>
	</styles>

	<view
		extends="lv_obj"
		width="100%"
		height="content"
		flex_flow="row"
		scrollable="false"
		style_flex_cross_place="center"
		style_pad_gap="#space_xs"
		style_bg_opa="0%"
		style_border_width="0"
		style_pad_all="0"
	>
		<style name="style_card_header" />

		<lv_label text="$icon" hidden="{!icon}">
			<style name="style_header_icon" />
		</lv_label>

		<lv_label text="$title">
			<style name="style_header_title" />
		</lv_label>
	</view>
</component>
