<component>
	<api>
		<prop name="grow" type="int" default="0" help="flex_grow in a flex parent" />
	</api>

	<styles>
		<style
			name="style_nav_bar"
			width="100%"
			height="40"
			pad_hor="#space_xs"
			pad_ver="#space_xs"
			pad_gap="#space_xs"
			flex_flow="row"
			flex_cross_place="center"
			flex_main_place="space_evenly"
			radius="0"
			border_width="1"
			bg_color="#color_nav_bg"
			bg_opa="100%"
			border_color="#color_nav_border"
			border_opa="100%"
		/>
	</styles>

	<view extends="lv_obj" flex_flow="row" width="100%" height="40" flex_grow="$grow">
		<style name="style_nav_bar" />

		<navigation_button name="nav_btn_home" label="Home" active="true" grow="1" />
		<navigation_button name="nav_btn_profile" label="Profile" active="false" grow="1" />
		<navigation_button name="nav_btn_manual" label="Manual" active="false" grow="1" />
		<navigation_button name="nav_btn_info" label="Info" active="false" grow="1" />
	</view>
</component>
