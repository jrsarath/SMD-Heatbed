<component>
	<api>
		<prop name="grow" type="int" default="0" help="flex_grow in a flex parent" />
		<prop name="active_home" type="bool" default="false" help="Highlight Home nav item" />
		<prop name="active_profiles" type="bool" default="false" help="Highlight Profiles nav item" />
		<prop name="active_manual" type="bool" default="false" help="Highlight Manual nav item" />
		<prop name="active_info" type="bool" default="false" help="Highlight Info nav item" />
	</api>

	<styles>
		<style
			name="style_nav_bar"
			width="100%"
			height="40"
			pad_hor="#space_xs"
			pad_ver="#space_xs"
			pad_gap="#space_xs"
			flex_flow="row"
			flex_cross_place="center"
			flex_main_place="space_evenly"
			radius="0"
			border_width="1"
			bg_color="#color_nav_bg"
			bg_opa="100%"
			border_color="#color_nav_border"
			border_opa="100%"
		/>
	</styles>

	<view extends="lv_obj" flex_flow="row" width="100%" height="40" flex_grow="$grow">
		<style name="style_nav_bar" />

		<navigation_button name="nav_btn_home" label="Home" active="$active_home" grow="1">
			<screen_create_event screen="home" trigger="clicked" />
		</navigation_button>
		<navigation_button name="nav_btn_profiles" label="Profiles" active="$active_profiles" grow="1">
			<screen_create_event screen="profiles" trigger="clicked" />
		</navigation_button>
		<navigation_button name="nav_btn_manual" label="Manual" active="$active_manual" grow="1">
			<screen_create_event screen="manual" trigger="clicked" />
		</navigation_button>
		<navigation_button name="nav_btn_info" label="Info" active="$active_info" grow="1">
			<screen_create_event screen="info" trigger="clicked" />
		</navigation_button>
	</view>
</component>
