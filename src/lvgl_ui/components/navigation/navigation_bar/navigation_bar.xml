<component>
	<previews>
		<preview name="light" width="320" height="40" />
		<preview name="dark" width="320" height="40" style_bg_color="#color_dark_bg">
			<set_subject name="subject_theme_dark" value="1" />
		</preview>
	</previews>

	<api>
		<prop name="grow" type="int" default="0" help="flex_grow in a flex parent; NULL = natural size" />
	</api>

	<styles>
		<!-- Navigation bar container geometry and flex layout -->
		<style
			name="style_nav_bar"
			width="100%"
			height="40"
			pad_hor="#space_xs"
			pad_ver="#space_xs"
			pad_gap="#space_xs"
			flex_flow="row"
			flex_cross_place="center"
			flex_main_place="space_evenly"
			radius="0"
			border_width="#border_width"
		/>
		<!-- Light theme panel background & border -->
		<style
			name="style_nav_bar_light"
			bg_color="#color_light_panel"
			bg_opa="100%"
			border_color="#color_light_text"
			border_opa="20%"
		/>
		<!-- Dark theme panel background & border -->
		<style
			name="style_nav_bar_dark"
			bg_color="#color_dark_panel"
			bg_opa="100%"
			border_color="#color_dark_text"
			border_opa="20%"
		/>
	</styles>

	<!-- Reusable Navigation Bar containing 5 navigation button instances distributed evenly.
	     Fixed 40px height, 100% width following parent container. -->
	<view extends="container" flow="row" width="100%" height="40" pad="0" gap="0" grow="$grow">
		<style name="style_nav_bar" />
		<style name="style_nav_bar_light" />
		<bind_style name="style_nav_bar_dark" subject="subject_theme_dark" ref_value="1" />

		<!-- 5 Navigation Button instances, each occupying ~20% of available width -->
		<navigation_button name="nav_btn_home" icon="icon_home" label="Home" active="true" grow="1" />
		<navigation_button name="nav_btn_profile" icon="icon_search" label="Profile" active="false" grow="1" />
		<navigation_button name="nav_btn_manual" icon="icon_star" label="Manual" active="false" grow="1" />
		<navigation_button name="nav_btn_settings" icon="icon_settings" label="Settings" active="false" grow="1" />
		<navigation_button name="nav_btn_info" icon="icon_info" label="Info" active="false" grow="1" />
	</view>
</component>
