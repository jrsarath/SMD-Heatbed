<component>
	<api>
		<prop name="title" type="string" default="Home" help="Header title text" />
		<prop name="status" type="string" default="Idle" help="Header status text" />
		<prop name="grow" type="int" default="0" help="flex_grow in a flex parent" />
	</api>

	<styles>
		<style
			name="style_header"
			bg_color="#color_nav_bg"
			width="100%"
			height="40"
			border_width="0"
			radius="0"
			flex_flow="row"
			flex_cross_place="center"
			flex_main_place="space_between"
		/>
		<style name="style_header_text" text_color="#color_accent" text_font="font_md" />
		<style name="style_status_text" text_color="#color_warning" text_font="font_sm" />
	</styles>

	<view extends="lv_obj" flex_flow="row" width="100%" height="40" flex_grow="$grow" scrollable="false">
		<style name="style_header" />

		<lv_label text="$title">
			<style name="style_header_text" />
		</lv_label>
		<lv_label text="$status">
			<style name="style_status_text" />
		</lv_label>
	</view>
</component>
