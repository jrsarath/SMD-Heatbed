<component>
	<api>
		<prop name="label" type="string" default="Home" help="Navigation button label text" />
		<prop name="active" type="bool" default="false" help="Whether this navigation item is active/selected" />
		<prop name="grow" type="int" default="1" help="flex_grow in a flex parent" />
	</api>

	<styles>
		<style
			name="style_nav_btn"
			flex_flow="column"
			bg_opa="0%"
			border_width="0"
			shadow_width="0"
			radius="4"
			pad_hor="#space_xs"
			pad_ver="#space_xs"
			flex_cross_place="center"
			flex_main_place="center"
			text_color="#color_nav_text"
		/>
		<style
			name="style_nav_btn_active"
			bg_color="#color_accent"
			bg_opa="100%"
			text_color="#color_accent_text"
			radius="4"
		/>
		<style name="style_nav_btn_pressed" bg_color="#color_accent_pressed" bg_opa="100%" />
		<style name="style_nav_btn_label" text_align="center" align="center" text_font="font_sm" />
	</styles>

	<view
		extends="lv_button"
		flex_flow="column"
		flex_grow="$grow"
		width="100%"
		height="100%"
		checkable="true"
		checked="$active"
		style_flex_main_place="center"
		style_flex_cross_place="center"
	>
		<style name="style_nav_btn" />
		<style name="style_nav_btn_active" selector="checked" />
		<style name="style_nav_btn_pressed" selector="pressed" />

		<lv_label text="$label" hidden="{!label}" width="100%">
			<style name="style_nav_btn_label" />
		</lv_label>
	</view>
</component>
