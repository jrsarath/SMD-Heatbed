<component>
	<previews>
		<preview name="light" width="100" height="40" />
		<preview name="dark" width="100" height="40" style_bg_color="#color_dark_bg">
			<set_subject name="subject_theme_dark" value="1" />
		</preview>
	</previews>

	<api>
		<prop name="label" type="string" default="Home" help="Navigation button label text" />
		<prop name="icon" type="image" default="icon_home" help="Navigation button icon image" />
		<prop name="active" type="bool" default="false" help="Whether this navigation item is active/selected" />
		<prop name="grow" type="int" default="1" help="flex_grow in a flex parent; NULL = natural size" />
	</api>

	<styles>
		<!-- Inactive navigation button base -->
		<style
			name="style_nav_btn"
			flex_flow="column"
			bg_opa="0%"
			border_width="0"
			shadow_width="0"
			radius="0"
			pad_hor="#space_xs"
			pad_ver="#space_xs"
			pad_gap="#space_xs"
			flex_cross_place="center"
			flex_main_place="center"
			text_font="font_body"
		/>
		<!-- Inactive light theme -->
		<style
			name="style_nav_btn_light"
			text_color="#color_light_text"
			text_opa="60%"
			image_recolor="#color_light_text"
			image_recolor_opa="60%"
		/>
		<!-- Inactive dark theme -->
		<style
			name="style_nav_btn_dark"
			text_color="#color_dark_text"
			text_opa="60%"
			image_recolor="#color_dark_text"
			image_recolor_opa="60%"
		/>
		<!-- Active / checked state -->
		<style
			name="style_nav_btn_active"
			bg_color="#color_accent"
			bg_opa="100%"
			text_color="#color_accent_text"
			text_opa="100%"
			image_recolor="#color_accent_text"
			image_recolor_opa="100%"
			radius="0"
		/>
		<!-- Pressed feedback -->
		<style name="style_nav_btn_pressed" recolor="#color_track" recolor_opa="40%" />
		<!-- Icon sizing / alignment -->
		<style name="style_nav_btn_icon" image_recolor_opa="100%" align="center" />
		<style name="style_nav_btn_label" text_font="font_md" text_align="center" align="center" />
	</styles>

	<!-- Reusable navigation button item: [icon] label.
	     Supports configurable icon, configurable label, active/selected and inactive visual states. -->
	<view
		extends="lv_button"
		flex_flow="column"
		flex_grow="$grow"
		width="100%"
		height="100%"
		checkable="true"
		checked="$active"
		style_flex_main_place="center"
		style_flex_cross_place="center"
	>
		<style name="style_nav_btn" />
		<style name="style_nav_btn_light" />
		<bind_style name="style_nav_btn_dark" subject="subject_theme_dark" ref_value="1" />
		<style name="style_nav_btn_active" selector="checked" />
		<style name="style_nav_btn_pressed" selector="pressed" />

		<lv_image src="$icon" hidden="{!icon}">
			<style name="style_nav_btn_icon" />
		</lv_image>
		<lv_label text="$label" hidden="{!label}" width="100%">
			<style name="style_nav_btn_label" />
		</lv_label>
	</view>
</component>
