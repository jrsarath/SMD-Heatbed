<screen>
	<view extends="lv_obj" width="100%" height="100%" flex_flow="column" style_bg_color="#color_dark_bg" style_pad_all="0">
		<!-- Header Banner -->
		<lv_obj
			width="100%"
			height="40"
			flex_flow="row"
			style_bg_color="#color_nav_bg"
			style_border_width="1"
			style_border_color="#color_nav_border"
			style_pad_hor="#space_md"
			style_flex_main_place="space_between"
			style_flex_cross_place="center"
		>
			<lv_label text="SYSTEM INFORMATION" style_text_color="#color_accent" style_text_font="font_md" />
			<lv_label text="v1.0.0" style_text_color="#color_text_muted" style_text_font="font_xs" />
		</lv_obj>

		<!-- Content Area -->
		<lv_obj
			width="100%"
			flex_grow="1"
			flex_flow="column"
			style_bg_opa="0%"
			style_border_width="0"
			style_pad_all="#space_sm"
			style_pad_gap="#space_sm"
		>
			<!-- Hardware Specs Card -->
			<lv_obj
				width="100%"
				flex_flow="column"
				style_bg_color="#color_card_bg"
				style_border_width="1"
				style_border_color="#color_card_border"
				style_radius="#radius_md"
				style_pad_all="#space_sm"
				style_pad_gap="#space_xs"
			>
				<lv_label
					text="HARDWARE SPECIFICATIONS"
					style_text_color="#color_text_muted"
					style_text_font="font_xs"
				/>
				<lv_label
					text="MCU: Raspberry Pi Pico (RP2040)"
					style_text_color="#color_text_primary"
					style_text_font="font_xs"
				/>
				<lv_label
					text="Display: 4.3 PicoDVI (240x320)"
					style_text_color="#color_text_primary"
					style_text_font="font_xs"
				/>
				<lv_label
					text="Sensor: 100K NTC (Beta=3950, R0=100K)"
					style_text_color="#color_text_primary"
					style_text_font="font_xs"
				/>
				<lv_label
					text="SSR Control: 3.3V Logic PWM @ 1kHz"
					style_text_color="#color_text_primary"
					style_text_font="font_xs"
				/>
			</lv_obj>

			<!-- Firmware & Safety Specs Card -->
			<lv_obj
				width="100%"
				flex_flow="column"
				style_bg_color="#color_card_bg"
				style_border_width="1"
				style_border_color="#color_card_border"
				style_radius="#radius_md"
				style_pad_all="#space_sm"
				style_pad_gap="#space_xs"
			>
				<lv_label
					text="SAFETY &amp; TELEMETRY"
					style_text_color="#color_text_muted"
					style_text_font="font_xs"
				/>
				<lv_label
					text="Max SSR Duty Limit: 40% Cap"
					style_text_color="#color_warning"
					style_text_font="font_xs"
				/>
				<lv_label
					text="Thermal Runaway Guard: Active"
					style_text_color="#color_success"
					style_text_font="font_xs"
				/>
				<lv_label
					text="Telemetry: UART TX/RX @ 115200 Baud"
					style_text_color="#color_text_primary"
					style_text_font="font_xs"
				/>
				<lv_label
					text="UI Engine: LVGL 9.5.0 Pro XML"
					style_text_color="#color_text_primary"
					style_text_font="font_xs"
				/>
			</lv_obj>
		</lv_obj>

		<!-- Bottom Navigation Bar -->
		<navigation_bar name="nav_bar" active_info="true" grow="0" />
	</view>
</screen>
