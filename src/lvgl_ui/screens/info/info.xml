<screen>
	<view
		extends="lv_obj"
		width="100%"
		height="100%"
		flex_flow="column"
		style_bg_color="#color_dark_bg"
		style_pad_all="0"
	>
		<!-- Header Banner -->
		<header title="Information" />

		<!-- Content Area (Vertically Scrollable) -->
		<lv_obj
			width="100%"
			flex_grow="1"
			flex_flow="column"
			style_bg_opa="0%"
			style_border_width="0"
			style_pad_all="#space_sm"
			style_pad_gap="#space_sm"
		>
			<!-- 1. DEVICE -->
			<lv_obj
				width="100%"
				height="content"
				flex_flow="column"
				scrollable="false"
				style_bg_color="#color_card_bg"
				style_bg_opa="100%"
				style_border_width="1"
				style_border_color="#color_card_border"
				style_border_opa="100%"
				style_radius="#radius_md"
				style_pad_hor="#space_sm"
				style_pad_ver="#space_sm"
				style_pad_gap="#space_xs"
			>
				<info_card_header title="DEVICE" icon="&#xF011;" />
				<info_row label="Device Name" value="SMD Heatbed" />
				<info_row label="Model" value="HB-01" />
				<info_row label="Firmware Version" value="v1.0.3" />
				<info_row label="UI Version" value="v1.0.0" show_separator="false" />
			</lv_obj>

