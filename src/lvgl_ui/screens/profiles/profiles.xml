<screen>
	<view
		extends="lv_obj"
		width="100%"
		height="100%"
		flex_flow="column"
		style_bg_color="#color_dark_bg"
		style_pad_all="0"
	>
		<!-- Header Banner -->
		<header title="Reflow Profiles" />

		<!-- Content List Area -->
		<lv_obj
			width="100%"
			flex_grow="1"
			flex_flow="column"
			style_bg_opa="0%"
			style_border_width="0"
			style_pad_all="#space_sm"
			style_pad_gap="#space_sm"
		/>

		<!-- Bottom Navigation Bar -->
		<navigation_bar name="nav_bar" active_profiles="true" grow="0" />
	</view>
</screen>
