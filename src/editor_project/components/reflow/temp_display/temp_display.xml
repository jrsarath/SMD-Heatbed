<component>
	<previews>
		<preview name="default" width="240" height="90" style_bg_color="#color_dark_bg" />
	</previews>

	<api>
		<prop name="current_temp" type="string" default="183°C" help="Current temperature readout string" />
		<prop name="target_temp" type="string" default="217°C" help="Target setpoint temperature string" />
	</api>

	<view extends="lv_obj" width="100%" flex_flow="column" style_pad_all="#space_sm" style_pad_row="#space_xs" style_bg_color="#color_dark_panel" style_border_color="#color_border" style_border_width="1" style_radius="#radius_card">
		<!-- Section Subtitle -->
		<lv_obj width="100%" flex_flow="row" style_flex_main_place="center" style_flex_cross_place="center" style_pad_column="#space_xs">
			<lv_image src="icon_thermometer" style_image_recolor="#color_accent" style_image_recolor_opa="100%" />
			<lv_label text="CURRENT TEMP" style_text_color="#color_text_secondary" style_text_font="font_body" style_text_letter_space="1" />
		</lv_obj>

		<!-- Hero Giant Temperature Value -->
		<lv_obj width="100%" flex_flow="row" style_flex_main_place="center" style_flex_cross_place="center">
			<lv_label bind_text="subject_current_temp" bind_text-fmt="%d°C" style_text_color="#color_accent" style_text_font="font_h1" />
		</lv_obj>

		<!-- Subordinate Target Readout -->
		<lv_obj width="100%" flex_flow="row" style_flex_main_place="center" style_flex_cross_place="center" style_pad_column="#space_xs">
			<lv_label text="TARGET:" style_text_color="#color_text_muted" style_text_font="font_body" />
			<lv_label bind_text="subject_target_temp" bind_text-fmt="%d°C" style_text_color="#color_text_primary" style_text_font="font_h4" />
		</lv_obj>
	</view>
</component>
