<component>
	<previews>
		<preview name="default" width="240" height="36" style_bg_color="#color_dark_bg" />
	</previews>

	<api>
		<prop name="active_stage" type="int" default="2" help="Active stage index (0=Preheat, 1=Soak, 2=Reflow, 3=Cooling, 4=Complete)" />
	</api>

	<view extends="lv_obj" width="100%" height="32" flex_flow="row" style_flex_cross_place="center" style_flex_main_place="space_between" style_pad_hor="#space_xs" style_pad_ver="#space_xs" style_bg_color="#color_dark_panel" style_border_color="#color_border" style_border_width="1" style_radius="#radius_card">
		<!-- Stage 1: PREHEAT (Done) -->
		<lv_obj flex_flow="row" style_flex_cross_place="center" style_pad_column="2">
			<lv_label text="✓" style_text_color="#color_success" style_text_font="font_body" />
			<lv_label text="PRE" style_text_color="#color_success" style_text_font="font_body" />
		</lv_obj>
		<lv_label text="›" style_text_color="#color_text_muted" />

		<!-- Stage 2: SOAK (Done) -->
		<lv_obj flex_flow="row" style_flex_cross_place="center" style_pad_column="2">
			<lv_label text="✓" style_text_color="#color_success" style_text_font="font_body" />
			<lv_label text="SOAK" style_text_color="#color_success" style_text_font="font_body" />
		</lv_obj>
		<lv_label text="›" style_text_color="#color_text_muted" />

		<!-- Stage 3: REFLOW (Active - Orange Pill) -->
		<lv_obj flex_flow="row" style_flex_cross_place="center" style_pad_column="2" style_pad_hor="#space_xs" style_pad_ver="2" style_bg_color="#color_accent" style_radius="#radius_pill">
			<lv_label text="●" style_text_color="#color_accent_text" style_text_font="font_body" />
			<lv_label text="REFLOW" style_text_color="#color_accent_text" style_text_font="font_h5" />
		</lv_obj>
		<lv_label text="›" style_text_color="#color_text_muted" />

		<!-- Stage 4: COOLING (Future) -->
		<lv_obj flex_flow="row" style_flex_cross_place="center" style_pad_column="2">
			<lv_label text="COOL" style_text_color="#color_cooling" style_text_font="font_body" />
		</lv_obj>
	</view>
</component>
