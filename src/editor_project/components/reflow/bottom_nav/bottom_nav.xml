<component>
	<previews>
		<preview name="default" width="240" height="42" style_bg_color="#color_dark_bg" />
	</previews>

	<api>
		<prop name="active_tab" type="int" default="0" help="Active tab index (0=Home, 1=Profiles, 2=Manual, 3=Settings, 4=Info)" />
	</api>

	<view extends="lv_obj" width="100%" height="40" flex_flow="row" style_flex_cross_place="center" style_flex_main_place="space_around" style_pad_hor="2" style_bg_color="#color_dark_panel" style_border_color="#color_border" style_border_width="1" style_border_side="top">
		<!-- Tab 0: HOME -->
		<lv_obj width="44" height="34" flex_flow="column" style_flex_cross_place="center" style_flex_main_place="center" style_radius="#radius_default" style_bg_color="#color_surface_elevated" style_border_color="#color_accent" style_border_width="1">
			<lv_image src="icon_home" style_image_recolor="#color_accent" style_image_recolor_opa="100%" />
			<lv_label text="HOME" style_text_color="#color_accent" style_text_font="font_body" />
		</lv_obj>

		<!-- Tab 1: PROFILES -->
		<lv_obj width="44" height="34" flex_flow="column" style_flex_cross_place="center" style_flex_main_place="center" style_radius="#radius_default">
			<lv_image src="icon_layers" style_image_recolor="#color_text_muted" style_image_recolor_opa="100%" />
			<lv_label text="PROF" style_text_color="#color_text_muted" style_text_font="font_body" />
		</lv_obj>

		<!-- Tab 2: MANUAL -->
		<lv_obj width="44" height="34" flex_flow="column" style_flex_cross_place="center" style_flex_main_place="center" style_radius="#radius_default">
			<lv_image src="icon_sliders" style_image_recolor="#color_text_muted" style_image_recolor_opa="100%" />
			<lv_label text="MAN" style_text_color="#color_text_muted" style_text_font="font_body" />
		</lv_obj>

		<!-- Tab 3: SETTINGS -->
		<lv_obj width="44" height="34" flex_flow="column" style_flex_cross_place="center" style_flex_main_place="center" style_radius="#radius_default">
			<lv_image src="icon_settings" style_image_recolor="#color_text_muted" style_image_recolor_opa="100%" />
			<lv_label text="SETT" style_text_color="#color_text_muted" style_text_font="font_body" />
		</lv_obj>

		<!-- Tab 4: INFO -->
		<lv_obj width="44" height="34" flex_flow="column" style_flex_cross_place="center" style_flex_main_place="center" style_radius="#radius_default">
			<lv_image src="icon_info" style_image_recolor="#color_text_muted" style_image_recolor_opa="100%" />
			<lv_label text="INFO" style_text_color="#color_text_muted" style_text_font="font_body" />
		</lv_obj>
	</view>
</component>
