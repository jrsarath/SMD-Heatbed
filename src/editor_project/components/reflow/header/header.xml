<component>
	<previews>
		<preview name="default" width="240" height="32" style_bg_color="#color_dark_bg" />
	</previews>

	<api>
		<prop name="title" type="string" default="REFLOW OVEN" help="Header title" />
		<prop name="time" type="string" default="12:45" help="Header clock time" />
		<prop name="icon" type="image" default="icon_flame" help="Header icon" />
	</api>

	<view extends="lv_obj" width="100%" height="28" flex_flow="row" style_flex_cross_place="center" style_pad_hor="#space_md" style_pad_column="#space_xs" style_bg_color="#color_dark_panel" style_border_color="#color_border" style_border_width="1" style_border_side="bottom">
		<lv_image src="$icon" style_image_recolor="#color_accent" style_image_recolor_opa="100%" />
		<lv_label text="$title" style_text_color="#color_text_primary" style_text_font="font_h5" style_text_letter_space="1" />
		<container grow="1" />
		<lv_obj width="6" height="6" style_bg_color="#color_success" style_radius="3" />
		<lv_label text="$time" style_text_color="#color_text_secondary" style_text_font="font_body" />
	</view>
</component>
