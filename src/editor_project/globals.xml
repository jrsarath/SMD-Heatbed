<globals>
	<!-- SMD REFLOW PLATE UI — DESIGN SYSTEM & TOKEN DEFINITIONS
	     Target: 240x320 Portrait LVGL Pro Editor Project
	     Visual Theme: Dark Industrial Appliance Touchscreen -->

	<api>
		<!-- Project-wide enums -->
	</api>

	<consts>
		<!-- Spacing scale -->
		<int name="space_xs" value="2" help="Smallest spacing unit" />
		<int name="space_sm" value="4" help="Small spacing unit" />
		<int name="space_md" value="8" help="Default spacing unit" />
		<int name="space_lg" value="12" help="Large spacing unit" />
		<int name="space_xl" value="16" help="Extra-large spacing unit" />

		<!-- Shape & Geometry -->
		<int name="radius_default" value="8" help="Default corner radius" />
		<int name="radius_card" value="10" help="Card corner radius" />
		<int name="radius_pill" value="16" help="Pill / Badge corner radius" />
		<int name="border_width" value="1" help="Default border width" />

		<int name="icon_size" value="16" help="Default icon size" />
		<int name="icon_size_lg" value="20" help="Large icon size" />
		<opa name="opa_muted" value="45%" help="Opacity for muted elements" />

		<!-- Dark Industrial Appliance Palette -->
		<color name="color_dark_bg" value="0x0D1117" help="Background: Dark charcoal / near-black" />
		<color name="color_dark_panel" value="0x171C23" help="Surface: Cards / panel background" />
		<color name="color_surface_elevated" value="0x1D232C" help="Elevated Surface: High-contrast cards" />
		<color name="color_border" value="0x303743" help="Subtle panel border" />

		<!-- Primary Thermal Accent -->
		<color name="color_accent" value="0xFF7A00" help="Primary Accent: Thermal Orange" />
		<color name="color_accent_text" value="0xFFFFFF" help="Text on thermal accent" />

		<!-- Semantic Status Colors -->
		<color name="color_success" value="0x65D84A" help="Success: Completed stage / ok" />
		<color name="color_danger" value="0xE53935" help="Danger: STOP / over-temp / alert" />
		<color name="color_cooling" value="0x29A9E8" help="Cooling: Cyan / Blue stage" />
		<color name="color_warning" value="0xFFB300" help="Warning: Sensor notice / amber" />

		<!-- Industrial Typography Colors -->
		<color name="color_text_primary" value="0xF2F4F7" help="High contrast primary text" />
		<color name="color_text_secondary" value="0xB7BEC8" help="Secondary text" />
		<color name="color_text_muted" value="0x737C88" help="Muted caption text" />

		<!-- Compatibility Tokens for Base Components -->
		<color name="color_light_bg" value="0x0D1117" />
		<color name="color_light_panel" value="0x171C23" />
		<color name="color_light_text" value="0xF2F4F7" />
		<color name="color_dark_text" value="0xF2F4F7" />
		<color name="color_track" value="0x303743" />
	</consts>

	<fonts>
		<bin
			name="font_body_symbols"
			size="16"
			src_path="fonts/FontAwesome5.ttf"
			bpp="4"
			range="0xF00C,0xF00D,0xF053-0xF054,0xF077-0xF078,0xF11C,0xF55A,0xF8A2"
			as_file="false"
		/>

		<bin
			name="font_body"
			size="14"
			src_path="fonts/Montserrat-Regular.ttf"
			bpp="4"
			range="0x20-0x7F"
			symbols="°—•✓●"
			as_file="false"
			lv_fallback="font_body_symbols_data"
		/>
		<bin
			name="font_h5"
			size="16"
			src_path="fonts/Montserrat-Medium.ttf"
			bpp="4"
			range="0x20-0x7F"
			symbols="°—•✓●"
			as_file="false"
		/>
		<bin
			name="font_h4"
			size="18"
			src_path="fonts/Montserrat-SemiBold.ttf"
			bpp="4"
			range="0x20-0x7F"
			symbols="°—•✓●"
			as_file="false"
		/>
		<bin
			name="font_h3"
			size="24"
			src_path="fonts/Montserrat-SemiBold.ttf"
			bpp="4"
			range="0x20-0x7F"
			symbols="°—•✓●"
			as_file="false"
		/>
		<bin
			name="font_h2"
			size="32"
			src_path="fonts/Montserrat-Bold.ttf"
			bpp="4"
			range="0x20-0x7F"
			symbols="°—•✓●"
			as_file="false"
		/>
		<bin
			name="font_h1"
			size="44"
			src_path="fonts/Montserrat-Bold.ttf"
			bpp="4"
			range="0x20-0x7F"
			symbols="°—•✓●"
			as_file="false"
		/>
	</fonts>

	<subjects>
		<!-- Reflow State Model Subjects -->
		<int name="subject_theme_dark" value="1" min_value="0" max_value="1" help="1 = Always Dark Industrial" />
		<int name="subject_active_tab" value="0" min_value="0" max_value="4" help="0=Home, 1=Profiles, 2=Manual, 3=Settings, 4=Info" />
		<int name="subject_current_temp" value="183" min_value="0" max_value="300" help="Current temperature in Celsius" />
		<int name="subject_target_temp" value="217" min_value="0" max_value="300" help="Target setpoint temperature in Celsius" />
		<int name="subject_heater_output" value="72" min_value="0" max_value="100" help="SSR heater duty percentage" />
		<int name="subject_stage_index" value="2" min_value="0" max_value="4" help="0=Preheat, 1=Soak, 2=Reflow, 3=Cooling, 4=Complete" />
		<int name="subject_heater_active" value="1" min_value="0" max_value="1" help="1=Active heating cycle, 0=Idle/Stopped" />
		<int name="subject_brightness" value="85" min_value="10" max_value="100" help="Display backlight percentage" />
		<int name="subject_beeper" value="1" min_value="0" max_value="1" help="1=Audio feedback enabled" />
		<int name="subject_manual_setpoint" value="180" min_value="0" max_value="250" help="Manual heating target" />
		<int name="subject_show_keyboard" value="0" help="Keyboard visibility toggle" />
	</subjects>

