	<styles>
		<!-- Screen Background -->
		<style
			name="style_screen_light"
			bg_color="#color_dark_bg"
			bg_opa="100%"
			text_color="#color_text_primary"
			text_font="font_body"
		/>
		<style
			name="style_screen_dark"
			bg_color="#color_dark_bg"
			bg_opa="100%"
			text_color="#color_text_primary"
			text_font="font_body"
		/>

		<!-- Panels / Cards -->
		<style
			name="style_panel_light"
			bg_color="#color_dark_panel"
			bg_opa="100%"
			border_color="#color_border"
			border_opa="100%"
			border_width="#border_width"
			text_color="#color_text_primary"
			pad_all="#space_md"
			radius="#radius_card"
		/>
		<style
			name="style_panel_dark"
			bg_color="#color_dark_panel"
			bg_opa="100%"
			border_color="#color_border"
			border_opa="100%"
			border_width="#border_width"
			text_color="#color_text_primary"
			pad_all="#space_md"
			radius="#radius_card"
		/>
		<style
			name="style_panel_elevated"
			bg_color="#color_surface_elevated"
			bg_opa="100%"
			border_color="#color_border"
			border_opa="100%"
			border_width="#border_width"
			text_color="#color_text_primary"
			pad_all="#space_md"
			radius="#radius_card"
		/>

		<!-- Text Styles -->
		<style name="style_text_accent" text_color="#color_accent" />
		<style name="style_text_success" text_color="#color_success" />
		<style name="style_text_danger" text_color="#color_danger" />
		<style name="style_text_cooling" text_color="#color_cooling" />
		<style name="style_text_warning" text_color="#color_warning" />
		<style name="style_text_secondary" text_color="#color_text_secondary" />
		<style name="style_text_muted" text_color="#color_text_muted" />

		<!-- Custom Reflow UI Styles -->
		<style
			name="style_hero_temp"
			text_color="#color_accent"
			text_font="font_h1"
		/>
		<style
			name="style_nav_active"
			bg_color="#color_surface_elevated"
			border_color="#color_accent"
			border_width="1"
			radius="#radius_default"
		/>
		<style
			name="style_btn_stop"
			bg_color="#color_danger"
			text_color="#color_accent_text"
			radius="#radius_default"
		/>
		<style
			name="style_scrollbar"
			width="#space_sm"
			radius="#space_sm"
			bg_color="#color_track"
			bg_opa="80%"
			pad_all="#space_sm"
		/>
	</styles>
</globals>
