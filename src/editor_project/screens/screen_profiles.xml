<screen permanent="true">
	<view extends="lv_obj" width="240" height="320">
		<style name="style_screen_dark" />

		<!-- Main Column Layout -->
		<column pad="0" gap="2">
			
			<!-- Header -->
			<header title="REFLOW PROFILES" time="12:45" icon="icon_layers" />

			<!-- Content Body Container -->
			<lv_obj width="100%" flex_flow="column" style_pad_hor="#space_sm" style_pad_ver="2" style_pad_row="4">
				
				<!-- Active Profile Summary Banner -->
				<lv_obj width="100%" flex_flow="column" style_pad_all="#space_sm" style_pad_row="2" style_bg_color="#color_surface_elevated" style_border_color="#color_accent" style_border_width="1" style_radius="#radius_card">
					<lv_obj width="100%" flex_flow="row" style_flex_main_place="space_between" style_flex_cross_place="center">
						<lv_obj flex_flow="row" style_flex_cross_place="center" style_pad_column="#space_xs">
							<lv_image src="icon_check" style_image_recolor="#color_success" style_image_recolor_opa="100%" />
							<lv_label text="ACTIVE PROFILE" style_text_color="#color_success" style_text_font="font_h5" />
						</lv_obj>
						<lv_label text="SAC305" style_text_color="#color_accent" style_text_font="font_h4" />
					</lv_obj>

					<!-- Parameter Grid -->
					<lv_obj width="100%" flex_flow="row" style_flex_main_place="space_between" style_flex_cross_place="center" style_pad_ver="2">
						<lv_obj flex_flow="column" style_pad_row="0">
							<lv_label text="SOAK TEMP" style_text_color="#color_text_muted" style_text_font="font_body" />
							<lv_label text="150 - 180°C" style_text_color="#color_text_primary" style_text_font="font_h5" />
						</lv_obj>
						<lv_obj flex_flow="column" style_pad_row="0">
							<lv_label text="REFLOW" style_text_color="#color_text_muted" style_text_font="font_body" />
							<lv_label text="&gt;217°C (60s)" style_text_color="#color_text_primary" style_text_font="font_h5" />
						</lv_obj>
						<lv_obj flex_flow="column" style_pad_row="0">
							<lv_label text="PEAK TEMP" style_text_color="#color_text_muted" style_text_font="font_body" />
							<lv_label text="245°C" style_text_color="#color_accent" style_text_font="font_h5" />
						</lv_obj>
					</lv_obj>
				</lv_obj>

				<!-- Profile List Selection -->
				<lv_label text="AVAILABLE PRESETS" style_text_color="#color_text_secondary" style_text_font="font_body" style_text_letter_space="1" />

				<lv_obj width="100%" flex_flow="column" style_pad_row="#space_xs">
					<!-- Preset 1: SAC305 Lead Free (Selected) -->
					<lv_obj width="100%" height="32" flex_flow="row" style_flex_main_place="space_between" style_flex_cross_place="center" style_pad_hor="#space_sm" style_bg_color="#color_dark_panel" style_border_color="#color_accent" style_border_width="2" style_radius="#radius_card">
						<lv_obj flex_flow="row" style_flex_cross_place="center" style_pad_column="#space_xs">
							<lv_image src="icon_layers" style_image_recolor="#color_accent" style_image_recolor_opa="100%" />
							<lv_obj flex_flow="column" style_pad_row="0">
								<lv_label text="SAC305 Lead Free" style_text_color="#color_text_primary" style_text_font="font_h5" />
								<lv_label text="Sn96.5 / Ag3.0 / Cu0.5 (Peak 245°C)" style_text_color="#color_text_muted" style_text_font="font_body" />
							</lv_obj>
						</lv_obj>
						<lv_label text="●" style_text_color="#color_accent" />
					</lv_obj>

					<!-- Preset 2: Sn63/Pb37 Leaded -->
					<lv_obj width="100%" height="32" flex_flow="row" style_flex_main_place="space_between" style_flex_cross_place="center" style_pad_hor="#space_sm" style_bg_color="#color_dark_panel" style_border_color="#color_border" style_border_width="1" style_radius="#radius_card">
						<lv_obj flex_flow="row" style_flex_cross_place="center" style_pad_column="#space_xs">
							<lv_image src="icon_layers" style_image_recolor="#color_text_secondary" style_image_recolor_opa="100%" />
							<lv_obj flex_flow="column" style_pad_row="0">
								<lv_label text="Sn63 / Pb37 Leaded" style_text_color="#color_text_primary" style_text_font="font_h5" />
								<lv_label text="Standard Eutectic (Peak 215°C)" style_text_color="#color_text_muted" style_text_font="font_body" />
							</lv_obj>
						</lv_obj>
						<lv_label text="○" style_text_color="#color_text_muted" />
					</lv_obj>

					<!-- Preset 3: Low Temp Bi58Sn42 -->
					<lv_obj width="100%" height="32" flex_flow="row" style_flex_main_place="space_between" style_flex_cross_place="center" style_pad_hor="#space_sm" style_bg_color="#color_dark_panel" style_border_color="#color_border" style_border_width="1" style_radius="#radius_card">
						<lv_obj flex_flow="row" style_flex_cross_place="center" style_pad_column="#space_xs">
							<lv_image src="icon_layers" style_image_recolor="#color_text_secondary" style_image_recolor_opa="100%" />
							<lv_obj flex_flow="column" style_pad_row="0">
								<lv_label text="Low Temp Bi58Sn42" style_text_color="#color_text_primary" style_text_font="font_h5" />
								<lv_label text="Bismuth Alloy (Peak 165°C)" style_text_color="#color_text_muted" style_text_font="font_body" />
							</lv_obj>
						</lv_obj>
						<lv_label text="○" style_text_color="#color_text_muted" />
					</lv_obj>

					<!-- Preset 4: Custom User Profile -->
					<lv_obj width="100%" height="32" flex_flow="row" style_flex_main_place="space_between" style_flex_cross_place="center" style_pad_hor="#space_sm" style_bg_color="#color_dark_panel" style_border_color="#color_border" style_border_width="1" style_radius="#radius_card">
						<lv_obj flex_flow="row" style_flex_cross_place="center" style_pad_column="#space_xs">
							<lv_image src="icon_sliders" style_image_recolor="#color_text_secondary" style_image_recolor_opa="100%" />
							<lv_obj flex_flow="column" style_pad_row="0">
								<lv_label text="Custom Profile 1" style_text_color="#color_text_primary" style_text_font="font_h5" />
								<lv_label text="User Defined Ramp/Soak" style_text_color="#color_text_muted" style_text_font="font_body" />
							</lv_obj>
						</lv_obj>
						<lv_label text="○" style_text_color="#color_text_muted" />
					</lv_obj>
				</lv_obj>

				<!-- Action Controls -->
				<lv_obj width="100%" height="32" flex_flow="row" style_flex_main_place="space_between" style_flex_cross_place="center" style_pad_column="#space_sm">
					<button text="LOAD PROFILE" icon="icon_check" bg_color="#color_accent" text_color="#color_accent_text" radius="#radius_default" />
					<button text="EDIT PROFILE" icon="icon_sliders" bg_color="#color_dark_panel" text_color="#color_text_primary" radius="#radius_default" />
				</lv_obj>

			</lv_obj>

			<!-- Bottom Navigation (Tab 1: PROFILES Active) -->
			<lv_obj width="100%" height="40" flex_flow="row" style_flex_cross_place="center" style_flex_main_place="space_around" style_pad_hor="2" style_bg_color="#color_dark_panel" style_border_color="#color_border" style_border_width="1" style_border_side="top">
				<!-- Tab 0: HOME -->
				<lv_obj width="44" height="34" flex_flow="column" style_flex_cross_place="center" style_flex_main_place="center" style_radius="#radius_default" clickable="true">
					<screen_load_event screen="screen_home" trigger="clicked" />
					<lv_image src="icon_home" style_image_recolor="#color_text_muted" style_image_recolor_opa="100%" />
					<lv_label text="HOME" style_text_color="#color_text_muted" style_text_font="font_body" />
				</lv_obj>

				<!-- Tab 1: PROFILES -->
				<lv_obj width="44" height="34" flex_flow="column" style_flex_cross_place="center" style_flex_main_place="center" style_radius="#radius_default" style_bg_color="#color_surface_elevated" style_border_color="#color_accent" style_border_width="1" clickable="true">
					<lv_image src="icon_layers" style_image_recolor="#color_accent" style_image_recolor_opa="100%" />
					<lv_label text="PROF" style_text_color="#color_accent" style_text_font="font_body" />
				</lv_obj>

				<!-- Tab 2: MANUAL -->
				<lv_obj width="44" height="34" flex_flow="column" style_flex_cross_place="center" style_flex_main_place="center" style_radius="#radius_default" clickable="true">
					<screen_load_event screen="screen_manual" trigger="clicked" />
					<lv_image src="icon_sliders" style_image_recolor="#color_text_muted" style_image_recolor_opa="100%" />
					<lv_label text="MAN" style_text_color="#color_text_muted" style_text_font="font_body" />
				</lv_obj>

				<!-- Tab 3: SETTINGS -->
				<lv_obj width="44" height="34" flex_flow="column" style_flex_cross_place="center" style_flex_main_place="center" style_radius="#radius_default" clickable="true">
					<screen_load_event screen="screen_settings" trigger="clicked" />
					<lv_image src="icon_settings" style_image_recolor="#color_text_muted" style_image_recolor_opa="100%" />
					<lv_label text="SETT" style_text_color="#color_text_muted" style_text_font="font_body" />
				</lv_obj>

				<!-- Tab 4: INFO -->
				<lv_obj width="44" height="34" flex_flow="column" style_flex_cross_place="center" style_flex_main_place="center" style_radius="#radius_default" clickable="true">
					<screen_load_event screen="screen_info" trigger="clicked" />
					<lv_image src="icon_info" style_image_recolor="#color_text_muted" style_image_recolor_opa="100%" />
					<lv_label text="INFO" style_text_color="#color_text_muted" style_text_font="font_body" />
				</lv_obj>
			</lv_obj>

		</column>
	</view>
</screen>
