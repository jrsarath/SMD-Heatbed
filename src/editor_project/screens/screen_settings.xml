<screen permanent="true">
	<view extends="lv_obj" width="240" height="320">
		<style name="style_screen_dark" />

		<!-- Main Column Layout -->
		<column pad="0" gap="2">
			
			<!-- Header -->
			<header title="SETTINGS" time="12:45" icon="icon_settings" />

			<!-- Content Area Container -->
			<lv_obj width="100%" flex_flow="column" style_pad_hor="#space_sm" style_pad_ver="2" style_pad_row="4">
				
				<list width="100%" style_bg_color="#color_dark_panel" style_border_color="#color_border" style_radius="#radius_card">
					<list_section text="DISPLAY &amp; CONTROL" />
					
					<!-- Backlight Brightness -->
					<list_item title="Backlight" subtitle="Display intensity" icon="icon_settings">
						<list_item-trailing>
							<lv_obj flex_flow="row" style_flex_cross_place="center" style_pad_column="#space_xs">
								<slider subject="subject_brightness" width="60" height="10" />
								<lv_label bind_text="subject_brightness" bind_text-fmt="%d%%" style_text_color="#color_accent" style_text_font="font_body" />
							</lv_obj>
						</list_item-trailing>
					</list_item>

					<!-- Audio Beeper -->
					<list_item title="Beeper Sound" subtitle="Audible alerts" icon="icon_info">
						<list_item-trailing>
							<switch subject="subject_beeper" />
						</list_item-trailing>
					</list_item>

					<list_separator />
					<list_section text="THERMAL SAFETY" />

					<!-- Max Temp Limit -->
					<list_item title="Overtemp Limit" subtitle="Hardware cutoff" icon="icon_flame">
						<list_item-trailing>
							<lv_label text="250°C" style_text_color="#color_danger" style_text_font="font_h5" />
						</list_item-trailing>
					</list_item>

					<!-- NTC Sensor Calibration -->
					<list_item title="NTC Offset" subtitle="Beta 3950 calibration" icon="icon_thermometer">
						<list_item-trailing>
							<lv_label text="0.0°C" style_text_color="#color_text_primary" style_text_font="font_h5" />
						</list_item-trailing>
					</list_item>

					<!-- Thermal Runaway Guard -->
					<list_item title="Thermal Guard" subtitle="18s / 2°C threshold" icon="icon_check">
						<list_item-trailing>
							<lv_label text="ENABLED" style_text_color="#color_success" style_text_font="font_h5" />
						</list_item-trailing>
					</list_item>
				</list>

			</lv_obj>

			<!-- Bottom Navigation (Tab 3: SETTINGS Active) -->
			<lv_obj width="100%" height="40" flex_flow="row" style_flex_cross_place="center" style_flex_main_place="space_around" style_pad_hor="2" style_bg_color="#color_dark_panel" style_border_color="#color_border" style_border_width="1" style_border_side="top">
				<!-- Tab 0: HOME -->
				<lv_obj width="44" height="34" flex_flow="column" style_flex_cross_place="center" style_flex_main_place="center" style_radius="#radius_default" clickable="true">
					<screen_load_event screen="screen_home" trigger="clicked" />
					<lv_image src="icon_home" style_image_recolor="#color_text_muted" style_image_recolor_opa="100%" />
					<lv_label text="HOME" style_text_color="#color_text_muted" style_text_font="font_body" />
				</lv_obj>

				<!-- Tab 1: PROFILES -->
				<lv_obj width="44" height="34" flex_flow="column" style_flex_cross_place="center" style_flex_main_place="center" style_radius="#radius_default" clickable="true">
					<screen_load_event screen="screen_profiles" trigger="clicked" />
					<lv_image src="icon_layers" style_image_recolor="#color_text_muted" style_image_recolor_opa="100%" />
					<lv_label text="PROF" style_text_color="#color_text_muted" style_text_font="font_body" />
				</lv_obj>

				<!-- Tab 2: MANUAL -->
				<lv_obj width="44" height="34" flex_flow="column" style_flex_cross_place="center" style_flex_main_place="center" style_radius="#radius_default" clickable="true">
					<screen_load_event screen="screen_manual" trigger="clicked" />
					<lv_image src="icon_sliders" style_image_recolor="#color_text_muted" style_image_recolor_opa="100%" />
					<lv_label text="MAN" style_text_color="#color_text_muted" style_text_font="font_body" />
				</lv_obj>

				<!-- Tab 3: SETTINGS -->
				<lv_obj width="44" height="34" flex_flow="column" style_flex_cross_place="center" style_flex_main_place="center" style_radius="#radius_default" style_bg_color="#color_surface_elevated" style_border_color="#color_accent" style_border_width="1" clickable="true">
					<lv_image src="icon_settings" style_image_recolor="#color_accent" style_image_recolor_opa="100%" />
					<lv_label text="SETT" style_text_color="#color_accent" style_text_font="font_body" />
				</lv_obj>

				<!-- Tab 4: INFO -->
				<lv_obj width="44" height="34" flex_flow="column" style_flex_cross_place="center" style_flex_main_place="center" style_radius="#radius_default" clickable="true">
					<screen_load_event screen="screen_info" trigger="clicked" />
					<lv_image src="icon_info" style_image_recolor="#color_text_muted" style_image_recolor_opa="100%" />
					<lv_label text="INFO" style_text_color="#color_text_muted" style_text_font="font_body" />
				</lv_obj>
			</lv_obj>

		</column>
	</view>
</screen>
