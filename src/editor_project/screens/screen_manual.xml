<screen permanent="true">
	<view extends="lv_obj" width="240" height="320">
		<style name="style_screen_dark" />

		<!-- Main Column Layout -->
		<column pad="0" gap="2">
			
			<!-- Header -->
			<header title="MANUAL MODE" time="12:45" icon="icon_sliders" />

			<!-- Content Area Container -->
			<lv_obj width="100%" flex_flow="column" style_pad_hor="#space_sm" style_pad_ver="2" style_pad_row="4">
				
				<!-- Safety Warning Banner -->
				<lv_obj width="100%" flex_flow="row" style_flex_cross_place="center" style_pad_all="#space_sm" style_pad_column="#space_xs" style_bg_color="#color_surface_elevated" style_border_color="#color_warning" style_border_width="1" style_radius="#radius_card">
					<lv_image src="icon_info" style_image_recolor="#color_warning" style_image_recolor_opa="100%" />
					<lv_label text="CAUTION: Manual mode bypasses profile safety timer limits. Maintain active supervision." width="190" style_text_color="#color_warning" style_text_font="font_body" />
				</lv_obj>

				<!-- Current State Dual Readout -->
				<lv_obj width="100%" height="52" flex_flow="row" style_flex_main_place="space_between" style_flex_cross_place="center">
					<!-- Current Temp Card -->
					<lv_obj width="114" height="52" flex_flow="column" style_flex_main_place="center" style_flex_cross_place="center" style_pad_all="#space_xs" style_bg_color="#color_dark_panel" style_border_color="#color_border" style_border_width="1" style_radius="#radius_card">
						<lv_label text="CURRENT TEMP" style_text_color="#color_text_muted" style_text_font="font_body" />
						<lv_label bind_text="subject_current_temp" bind_text-fmt="%d°C" style_text_color="#color_accent" style_text_font="font_h2" />
					</lv_obj>

					<!-- Heater Output Card -->
					<lv_obj width="114" height="52" flex_flow="column" style_flex_main_place="center" style_flex_cross_place="center" style_pad_all="#space_xs" style_bg_color="#color_dark_panel" style_border_color="#color_border" style_border_width="1" style_radius="#radius_card">
						<lv_label text="HEATER OUTPUT" style_text_color="#color_text_muted" style_text_font="font_body" />
						<lv_label bind_text="subject_heater_output" bind_text-fmt="%d%%" style_text_color="#color_text_primary" style_text_font="font_h2" />
					</lv_obj>
				</lv_obj>

				<!-- Manual Temperature Setpoint Adjustment -->
				<lv_obj width="100%" flex_flow="column" style_flex_cross_place="center" style_pad_all="#space_sm" style_pad_row="#space_xs" style_bg_color="#color_dark_panel" style_border_color="#color_border" style_border_width="1" style_radius="#radius_card">
					<lv_label text="MANUAL TARGET SETPOINT" style_text_color="#color_text_secondary" style_text_font="font_body" style_text_letter_space="1" />
					
					<lv_obj width="100%" flex_flow="row" style_flex_main_place="space_between" style_flex_cross_place="center" style_pad_ver="#space_xs">
						<!-- Decrease Button -->
						<button text="-" bg_color="#color_surface_elevated" text_color="#color_text_primary" radius="#radius_default" />
						
						<!-- Target Readout -->
						<lv_obj flex_flow="column" style_flex_cross_place="center" style_pad_row="0">
							<lv_label bind_text="subject_manual_setpoint" bind_text-fmt="%d°C" style_text_color="#color_accent" style_text_font="font_h2" />
							<lv_label text="SETPOINT" style_text_color="#color_text_muted" style_text_font="font_body" />
						</lv_obj>

						<!-- Increase Button -->
						<button text="+" bg_color="#color_surface_elevated" text_color="#color_text_primary" radius="#radius_default" />
					</lv_obj>

					<slider subject="subject_manual_setpoint" width="100%" height="12" color="#color_accent" />
				</lv_obj>

				<!-- Master Power Control Button -->
				<button text="START HEATING CYCLE" icon="icon_flame" bg_color="#color_accent" text_color="#color_accent_text" radius="#radius_default" />

			</lv_obj>

			<!-- Bottom Navigation (Tab 2: MANUAL Active) -->
			<lv_obj width="100%" height="40" flex_flow="row" style_flex_cross_place="center" style_flex_main_place="space_around" style_pad_hor="2" style_bg_color="#color_dark_panel" style_border_color="#color_border" style_border_width="1" style_border_side="top">
				<!-- Tab 0: HOME -->
				<lv_obj width="44" height="34" flex_flow="column" style_flex_cross_place="center" style_flex_main_place="center" style_radius="#radius_default" clickable="true">
					<screen_load_event screen="screen_home" trigger="clicked" />
					<lv_image src="icon_home" style_image_recolor="#color_text_muted" style_image_recolor_opa="100%" />
					<lv_label text="HOME" style_text_color="#color_text_muted" style_text_font="font_body" />
				</lv_obj>

				<!-- Tab 1: PROFILES -->
				<lv_obj width="44" height="34" flex_flow="column" style_flex_cross_place="center" style_flex_main_place="center" style_radius="#radius_default" clickable="true">
					<screen_load_event screen="screen_profiles" trigger="clicked" />
					<lv_image src="icon_layers" style_image_recolor="#color_text_muted" style_image_recolor_opa="100%" />
					<lv_label text="PROF" style_text_color="#color_text_muted" style_text_font="font_body" />
				</lv_obj>

				<!-- Tab 2: MANUAL -->
				<lv_obj width="44" height="34" flex_flow="column" style_flex_cross_place="center" style_flex_main_place="center" style_radius="#radius_default" style_bg_color="#color_surface_elevated" style_border_color="#color_accent" style_border_width="1" clickable="true">
					<lv_image src="icon_sliders" style_image_recolor="#color_accent" style_image_recolor_opa="100%" />
					<lv_label text="MAN" style_text_color="#color_accent" style_text_font="font_body" />
				</lv_obj>

				<!-- Tab 3: SETTINGS -->
				<lv_obj width="44" height="34" flex_flow="column" style_flex_cross_place="center" style_flex_main_place="center" style_radius="#radius_default" clickable="true">
					<screen_load_event screen="screen_settings" trigger="clicked" />
					<lv_image src="icon_settings" style_image_recolor="#color_text_muted" style_image_recolor_opa="100%" />
					<lv_label text="SETT" style_text_color="#color_text_muted" style_text_font="font_body" />
				</lv_obj>

				<!-- Tab 4: INFO -->
				<lv_obj width="44" height="34" flex_flow="column" style_flex_cross_place="center" style_flex_main_place="center" style_radius="#radius_default" clickable="true">
					<screen_load_event screen="screen_info" trigger="clicked" />
					<lv_image src="icon_info" style_image_recolor="#color_text_muted" style_image_recolor_opa="100%" />
					<lv_label text="INFO" style_text_color="#color_text_muted" style_text_font="font_body" />
				</lv_obj>
			</lv_obj>

		</column>
	</view>
</screen>
